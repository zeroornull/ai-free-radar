  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.5",
