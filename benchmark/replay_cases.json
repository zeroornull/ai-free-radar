    {
      "id": "budget-exhausted",
      "description": "基线搜索已用满本段预算，补搜不得越界或伪装成已完成；没有新增目标时应如实报告预算耗尽。",
      "category": "image",
      "observations": [
        {
          "url": "https://pixel.example.org/free-tier",
          "title": "Pixel image API free tier",
          "snippet": "Free tier is available for image generation.",
          "access": "snippet"
        },
        {
          "url": "https://render.example.net/free-trial",
          "title": "Render image API trial",
          "snippet": "Free trial for image rendering API.",
          "access": "snippet"
        }
      ],
      "budgets": {
        "search_limit": 6,
        "fetch_limit": 32,
        "baseline_search_calls": 6,
        "baseline_fetch_calls": 0,
        "gap_limit": 2
      },
      "expected_targets": [
        {
          "id": "pixel-free-tier",
          "urls": ["https://pixel.example.org/pricing"],
          "evidence_phrases": ["free tier"]
