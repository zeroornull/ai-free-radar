{
  "schema_version": 1,
  "description": "AIFreeRadar 冻结回放评测夹具。全部名称、URL、额度与页面摘录均为隔离的合成评测数据，不是生产种子资源，也不代表任何真实服务的可用性。回放不触网、不调用模型、不改写数据库。",
  "cases": [
    {
      "id": "alias-credit-wording",
      "description": "观察内容使用别名与“free credits/试用”措辞，补充读取的定价页以不同措辞给出量化免费额度；目标必须有页面原文支撑。",
      "category": "text",
      "observations": [
        {
          "url": "https://community.example.org/kinetic-note",
          "title": "Kinetic Labs, formerly Kinetic AI, offers free credits",
          "snippet": "Text API trial credits are available this month.",
          "source_id": "fixture-community",
          "access": "snippet"
        }
      ],
      "provider_outcomes": [
        {
          "trigger_url": "https://community.example.org/kinetic-note",
          "source_id": "fixture-community",
          "status": "ok",
          "results": [
            {
              "url": "https://kinetic.example/pricing",
              "title": "Kinetic text API pricing",
              "snippet": "Free tier details for the text API.",
              "access": "snippet"
            }
          ],
          "pages": [
            {
              "url": "https://kinetic.example/pricing",
              "text": "Free tier includes 1,000 requests per month for new accounts. Kinetic text API offers kinetic-1 on base-model-x.",
              "access": "page"
            }
          ]
        }
      ],
      "expected_targets": [
        {
          "id": "kinetic-free-tier",
          "urls": ["https://kinetic.example/pricing"],
          "evidence_phrases": ["1,000 requests per month"]
        }
      ],
      "expected_gaps": [
        {
          "trigger_url": "https://community.example.org/kinetic-note",
          "target_ids": ["kinetic-free-tier"]
        }
      ],
      "field_claims": [
        {
          "kind": "quota_fact",
          "payload": {
            "amount": 1000,
            "unit": "requests",
            "period": "month",
            "scope": "new accounts",
            "condition": "new accounts",
            "model_ids": [],
            "source_url": "https://kinetic.example/pricing",
            "quote": "Free tier includes 1,000 requests per month for new accounts.",
            "value_phrase": "1,000 requests per month"
          },
          "expect": "accepted"
        },
        {
          "kind": "model_deployment",
          "payload": {
            "provider": "Kinetic",
            "model_id": "kinetic-1",
            "base_model": "base-model-x",
            "source_url": "https://kinetic.example/pricing",
            "quote": "Kinetic text API offers kinetic-1 on base-model-x."
          },
          "expect": "accepted"
        }
      ],
      "expectations": {
        "planned_gap_count": 1,
        "stop_reasons": ["gap_resolved"],
        "baseline_targets": 0,
        "final_targets": 1,
        "added_targets": 1,
        "additional_requests": 2,
        "requests_per_added_target": 2.0,
        "duplicate_queries": 0,
        "budget_violations": 0,
        "false_resolved_gaps": 0,
        "field_evidence_support": 1.0
      }
    },
    {
      "id": "repeated-source-dedup",
      "description": "同一来源的重复转发与改写措辞只计划一次补搜；返回列表长度与重复条目都不增加目标召回。",
