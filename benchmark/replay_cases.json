      "expected_gaps": [
        {
          "trigger_url": "https://pixel.example.org/free-tier",
          "target_ids": ["pixel-free-tier"]
        },
        {
          "trigger_url": "https://render.example.net/free-trial",
          "target_ids": ["render-free-trial"]
        }
      ],
      "expectations": {
        "planned_gap_count": 2,
        "stop_reasons": ["budget_exhausted", "budget_exhausted"],
        "additional_requests": 0,
        "added_targets": 0,
        "requests_per_added_target": null,
