# 复制为 .env，仅填写实际使用的服务；不要提交 .env。
# 密钥变量名由 config.toml 的 model_api_key_env/search_api_key_env 指定。
OPENAI_API_KEY=replace-with-your-openai-key
ANTHROPIC_API_KEY=replace-with-your-anthropic-key
DEEPSEEK_API_KEY=replace-with-your-deepseek-key
# OpenAI 兼容端点：model 写模型名，model_base_url 写地址，密钥放这里。
XAI_API_KEY=replace-with-your-xai-key
# 通用兼容端点：config.toml 的 model_api_key_env = "MODEL_API_KEY"
MODEL_API_KEY=replace-with-your-model-key
TAVILY_API_KEY=replace-with-your-tavily-key
BRAVE_API_KEY=replace-with-your-brave-search-key
EXA_API_KEY=replace-with-your-exa-key
# 主密钥：用于在数据库中加密“设置”页保存的 model_api_key / search_api_key。
# 必须是 32 字节随机数的 urlsafe base64；生成后填入下方并保持私密。
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 数据库中已存在加密密钥而缺少（或无法解析）该主密钥时，启动会失败。
# 请与数据库备份分开保存；此变量不用于读取环境变量形式的普通密钥。
AIFREERADAR_SECRET_KEY=
# 可选：配置文件位置。默认读取当前工作目录的 config.toml。
# AIFREERADAR_CONFIG=D:/OwnWorkSpace/Demo/AIFreeRadar/config.toml
